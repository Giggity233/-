# 蘑菇头中控平台服务器配置。复制为 server.env 后按实际服务器修改。
# 密码默认即为 123456；如服务器 MySQL 密码不同，再修改 MYSQL_PASSWORD。
MYSQL_DATABASE=lianzun
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# 0.0.0.0 表示允许服务器网卡接收访问；建议在防火墙中仅放行可信内网。
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_THREADS=8

# 默认允许内网通过服务器 IP 访问。若只使用固定 IP/域名，建议改成例如
# 192.168.1.20,localhost,127.0.0.1。由于采集接口没有鉴权，切勿将服务直接暴露到互联网。
DJANGO_ALLOWED_HOSTS=*

# 首次启动时自动创建该管理员；后续不会覆盖其密码。
INITIAL_ADMIN_USERNAME=guangon1
INITIAL_ADMIN_PASSWORD=heyiwei111
INITIAL_ADMIN_RESPONSIBLE_NAME=平台管理员
